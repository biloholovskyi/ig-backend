# Development database (Supabase PostgreSQL connection pooler)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instagallery?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/instagallery?schema=public

# Note: Integration tests automatically use the local Docker Postgres (port 5433)
# Start it with: docker compose up -d
# The test DATABASE_URL is set automatically in test/setup.ts

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production

PORT=3001
FRONTEND_URL=http://localhost:3000
