# Database (Supabase PostgreSQL)
# Transaction pooler — use for app queries (port 6543)
DATABASE_URL=postgresql://postgres.[ref]:6543/postgres
# Direct connection — use for migrations only (port 5432)
DIRECT_URL=postgresql://postgres.[ref]:5432/postgres

# Note: Integration tests automatically use the local Docker Postgres (port 5433)
# Start it with: docker compose up -d
# The test DATABASE_URL is set automatically in test/setup.ts

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key            # Settings → API → anon public
SUPABASE_SERVICE_KEY=your-service-role-key  # Settings → API → service_role

# JWT — use the JWT Secret from Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

PORT=3001
FRONTEND_URL=http://localhost:3000
